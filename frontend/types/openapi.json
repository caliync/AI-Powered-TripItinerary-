{
  "components": {
    "schemas": {
      "AccessNeed": {
        "enum": [
          "wheelchair",
          "minimal_walking",
          "sensory_friendly"
        ],
        "title": "AccessNeed",
        "type": "string"
      },
      "AccessStatus": {
        "enum": [
          "yes",
          "limited",
          "no",
          "unknown"
        ],
        "title": "AccessStatus",
        "type": "string"
      },
      "Accessibility": {
        "additionalProperties": false,
        "properties": {
          "rough_terrain": {
            "default": false,
            "title": "Rough Terrain",
            "type": "boolean"
          },
          "sensory_friendly": {
            "$ref": "#/components/schemas/AccessStatus",
            "default": "unknown"
          },
          "sources": {
            "default": [],
            "items": {
              "enum": [
                "osm",
                "curated"
              ],
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "walk_m_estimate": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Walk M Estimate"
          },
          "wheelchair": {
            "$ref": "#/components/schemas/AccessStatus",
            "default": "unknown"
          }
        },
        "title": "Accessibility",
        "type": "object"
      },
      "BudgetTier": {
        "enum": [
          "budget",
          "mid",
          "premium"
        ],
        "title": "BudgetTier",
        "type": "string"
      },
      "DayPlan": {
        "additionalProperties": false,
        "properties": {
          "centroid": {
            "$ref": "#/components/schemas/LatLng"
          },
          "cluster_id": {
            "minimum": 0.0,
            "title": "Cluster Id",
            "type": "integer"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/Leg"
            },
            "title": "Legs",
            "type": "array"
          },
          "radius_m": {
            "minimum": 0.0,
            "title": "Radius M",
            "type": "integer"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/Stop"
            },
            "maxItems": 8,
            "title": "Stops",
            "type": "array"
          },
          "total_travel_s": {
            "minimum": 0.0,
            "title": "Total Travel S",
            "type": "integer"
          },
          "warnings": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ItineraryWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "date",
          "cluster_id",
          "centroid",
          "radius_m",
          "stops",
          "legs",
          "total_travel_s"
        ],
        "title": "DayPlan",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "GroupSize": {
        "enum": [
          "solo",
          "duo",
          "group"
        ],
        "title": "GroupSize",
        "type": "string"
      },
      "Interest": {
        "enum": [
          "traditional_food",
          "seafood",
          "cafes",
          "malls",
          "waterfalls",
          "farms",
          "parks",
          "hot_springs"
        ],
        "title": "Interest",
        "type": "string"
      },
      "Itinerary": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/DayPlan"
            },
            "title": "Days",
            "type": "array"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "intake": {
            "$ref": "#/components/schemas/TripIntake"
          },
          "providers": {
            "$ref": "#/components/schemas/Providers",
            "default": {
              "places": "osm",
              "routing": "osrm"
            }
          },
          "stay_coords": {
            "$ref": "#/components/schemas/LatLng"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "intake",
          "stay_coords",
          "days",
          "generated_at"
        ],
        "title": "Itinerary",
        "type": "object"
      },
      "ItineraryWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/WarningCode"
          },
          "message": {
            "maxLength": 300,
            "title": "Message",
            "type": "string"
          },
          "place_id": {
            "anyOf": [
              {
                "pattern": "^(osm:(node|way|relation)/\\d+|curated:[a-z0-9-]{1,64})$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ItineraryWarning",
        "type": "object"
      },
      "LatLng": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "LatLng",
        "type": "object"
      },
      "Leg": {
        "additionalProperties": false,
        "properties": {
          "distance_m": {
            "minimum": 0.0,
            "title": "Distance M",
            "type": "integer"
          },
          "duration_s": {
            "minimum": 0.0,
            "title": "Duration S",
            "type": "integer"
          },
          "from_id": {
            "title": "From Id",
            "type": "string"
          },
          "geometry": {
            "title": "Geometry",
            "type": "string"
          },
          "to_id": {
            "title": "To Id",
            "type": "string"
          },
          "traffic_factor": {
            "default": 1.0,
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Traffic Factor",
            "type": "number"
          }
        },
        "required": [
          "from_id",
          "to_id",
          "distance_m",
          "duration_s",
          "geometry"
        ],
        "title": "Leg",
        "type": "object"
      },
      "Place": {
        "additionalProperties": false,
        "properties": {
          "accessibility": {
            "$ref": "#/components/schemas/Accessibility",
            "default": {
              "rough_terrain": false,
              "sensory_friendly": "unknown",
              "sources": [],
              "wheelchair": "unknown"
            }
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Interest"
              },
              {
                "enum": [
                  "landmark",
                  "other"
                ],
                "type": "string"
              }
            ],
            "title": "Category"
          },
          "coords": {
            "$ref": "#/components/schemas/LatLng"
          },
          "hours_verified": {
            "default": false,
            "title": "Hours Verified",
            "type": "boolean"
          },
          "id": {
            "pattern": "^(osm:(node|way|relation)/\\d+|curated:[a-z0-9-]{1,64})$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "opening_hours": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opening Hours"
          },
          "outdoor": {
            "title": "Outdoor",
            "type": "boolean"
          },
          "price_tier": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BudgetTier"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "coords",
          "category",
          "outdoor"
        ],
        "title": "Place",
        "type": "object"
      },
      "Providers": {
        "additionalProperties": false,
        "properties": {
          "llm": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm"
          },
          "places": {
            "const": "osm",
            "default": "osm",
            "title": "Places",
            "type": "string"
          },
          "routing": {
            "default": "osrm",
            "enum": [
              "osrm",
              "estimate"
            ],
            "title": "Routing",
            "type": "string"
          }
        },
        "title": "Providers",
        "type": "object"
      },
      "RegionId": {
        "description": "Beta launches with Calamba; other Laguna cities are added here.",
        "enum": [
          "calamba"
        ],
        "title": "RegionId",
        "type": "string"
      },
      "StayLocation": {
        "additionalProperties": false,
        "properties": {
          "coords": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatLng"
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "title": "StayLocation",
        "type": "object"
      },
      "StaySuggestion": {
        "additionalProperties": false,
        "description": "A hotel, guest house or resort offered while the traveller types where they stay.",
        "properties": {
          "coords": {
            "$ref": "#/components/schemas/LatLng"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "coords"
        ],
        "title": "StaySuggestion",
        "type": "object"
      },
      "Stop": {
        "additionalProperties": false,
        "properties": {
          "arrive": {
            "format": "time",
            "title": "Arrive",
            "type": "string"
          },
          "depart": {
            "format": "time",
            "title": "Depart",
            "type": "string"
          },
          "dwell_min": {
            "maximum": 240.0,
            "minimum": 15.0,
            "title": "Dwell Min",
            "type": "integer"
          },
          "order": {
            "minimum": 0.0,
            "title": "Order",
            "type": "integer"
          },
          "place": {
            "$ref": "#/components/schemas/Place"
          },
          "reason": {
            "maxLength": 280,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "order",
          "place",
          "arrive",
          "depart",
          "dwell_min",
          "reason"
        ],
        "title": "Stop",
        "type": "object"
      },
      "StopAdd": {
        "additionalProperties": false,
        "properties": {
          "day_index": {
            "minimum": 0.0,
            "title": "Day Index",
            "type": "integer"
          },
          "meal": {
            "anyOf": [
              {
                "enum": [
                  "lunch",
                  "dinner"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meal"
          },
          "new_place_id": {
            "pattern": "^(osm:(node|way|relation)/\\d+|curated:[a-z0-9-]{1,64})$",
            "title": "New Place Id",
            "type": "string"
          },
          "part": {
            "enum": [
              "morning",
              "afternoon",
              "evening"
            ],
            "title": "Part",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "day_index",
          "new_place_id",
          "part"
        ],
        "title": "StopAdd",
        "type": "object"
      },
      "StopChoices": {
        "additionalProperties": false,
        "description": "Other places the traveller can pick for one stop of a day.",
        "properties": {
          "options": {
            "items": {
              "$ref": "#/components/schemas/SwapCandidate"
            },
            "title": "Options",
            "type": "array"
          },
          "stop_order": {
            "minimum": 0.0,
            "title": "Stop Order",
            "type": "integer"
          }
        },
        "required": [
          "stop_order",
          "options"
        ],
        "title": "StopChoices",
        "type": "object"
      },
      "StopRemove": {
        "additionalProperties": false,
        "properties": {
          "day_index": {
            "minimum": 0.0,
            "title": "Day Index",
            "type": "integer"
          },
          "stop_order": {
            "minimum": 0.0,
            "title": "Stop Order",
            "type": "integer"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "day_index",
          "stop_order"
        ],
        "title": "StopRemove",
        "type": "object"
      },
      "Submission": {
        "additionalProperties": false,
        "description": "A business owner's form entry, before review.",
        "properties": {
          "business_name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Business Name",
            "type": "string"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Interest"
              },
              {
                "enum": [
                  "landmark",
                  "other"
                ],
                "type": "string"
              }
            ],
            "title": "Category"
          },
          "contact_email": {
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Contact Email",
            "type": "string"
          },
          "coords": {
            "$ref": "#/components/schemas/LatLng"
          },
          "opening_hours": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opening Hours"
          },
          "region": {
            "$ref": "#/components/schemas/RegionId"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          },
          "wheelchair": {
            "$ref": "#/components/schemas/AccessStatus",
            "default": "unknown"
          }
        },
        "required": [
          "region",
          "business_name",
          "category",
          "coords",
          "contact_email"
        ],
        "title": "Submission",
        "type": "object"
      },
      "SubmissionReceived": {
        "properties": {
          "status": {
            "const": "pending",
            "default": "pending",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "SubmissionReceived",
        "type": "object"
      },
      "SwapApply": {
        "additionalProperties": false,
        "properties": {
          "day_index": {
            "minimum": 0.0,
            "title": "Day Index",
            "type": "integer"
          },
          "new_place_id": {
            "pattern": "^(osm:(node|way|relation)/\\d+|curated:[a-z0-9-]{1,64})$",
            "title": "New Place Id",
            "type": "string"
          },
          "stop_order": {
            "minimum": 0.0,
            "title": "Stop Order",
            "type": "integer"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "day_index",
          "stop_order",
          "new_place_id"
        ],
        "title": "SwapApply",
        "type": "object"
      },
      "SwapCandidate": {
        "additionalProperties": false,
        "properties": {
          "delta_travel_s": {
            "title": "Delta Travel S",
            "type": "integer"
          },
          "distance_from_old_m": {
            "maximum": 20000.0,
            "minimum": 0.0,
            "title": "Distance From Old M",
            "type": "integer"
          },
          "place": {
            "$ref": "#/components/schemas/Place"
          },
          "warnings": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ItineraryWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "place",
          "delta_travel_s",
          "distance_from_old_m"
        ],
        "title": "SwapCandidate",
        "type": "object"
      },
      "SwapRequest": {
        "additionalProperties": false,
        "properties": {
          "day_index": {
            "minimum": 0.0,
            "title": "Day Index",
            "type": "integer"
          },
          "exclude_ids": {
            "default": [],
            "items": {
              "pattern": "^(osm:(node|way|relation)/\\d+|curated:[a-z0-9-]{1,64})$",
              "type": "string"
            },
            "maxItems": 50,
            "title": "Exclude Ids",
            "type": "array"
          },
          "radius_m": {
            "default": 3000,
            "maximum": 5000.0,
            "minimum": 3000.0,
            "title": "Radius M",
            "type": "integer"
          },
          "stop_order": {
            "minimum": 0.0,
            "title": "Stop Order",
            "type": "integer"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "day_index",
          "stop_order"
        ],
        "title": "SwapRequest",
        "type": "object"
      },
      "TripIntake": {
        "additionalProperties": false,
        "properties": {
          "access_needs": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/AccessNeed"
            },
            "title": "Access Needs",
            "type": "array",
            "uniqueItems": true
          },
          "allow_unverified_access": {
            "default": true,
            "title": "Allow Unverified Access",
            "type": "boolean"
          },
          "budget": {
            "$ref": "#/components/schemas/BudgetTier"
          },
          "budget_php": {
            "anyOf": [
              {
                "maximum": 10000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget Php"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "group": {
            "$ref": "#/components/schemas/GroupSize"
          },
          "group_count": {
            "anyOf": [
              {
                "maximum": 30.0,
                "minimum": 3.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Group Count"
          },
          "include_meals": {
            "default": true,
            "title": "Include Meals",
            "type": "boolean"
          },
          "interests": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Interest"
            },
            "title": "Interests",
            "type": "array",
            "uniqueItems": true
          },
          "interests_text": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interests Text"
          },
          "places_per_day": {
            "anyOf": [
              {
                "maximum": 6.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Places Per Day"
          },
          "region": {
            "$ref": "#/components/schemas/RegionId",
            "default": "calamba"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "start_time": {
            "default": "08:00:00",
            "format": "time",
            "title": "Start Time",
            "type": "string"
          },
          "stay": {
            "$ref": "#/components/schemas/StayLocation"
          }
        },
        "required": [
          "stay",
          "start_date",
          "end_date",
          "group",
          "budget"
        ],
        "title": "TripIntake",
        "type": "object"
      },
      "WarningCode": {
        "enum": [
          "stop_closed_rescheduled",
          "hours_unverified",
          "access_unverified",
          "peak_traffic_leg",
          "unreachable_by_road",
          "light_day",
          "day_trimmed",
          "no_nearby_alternative",
          "stay_ambiguous",
          "degraded_data"
        ],
        "title": "WarningCode",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Calamba Trip Planner API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/itinerary/generate": {
      "post": {
        "operationId": "generate_api_v1_itinerary_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripIntake"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
